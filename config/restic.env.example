# Store the real file at /etc/wai-telegram/restic.env with mode 0600.
RESTIC_REPOSITORY=s3:https://nbg1.your-objectstorage.com/your-private-bucket/wai-telegram
RESTIC_PASSWORD_FILE=/etc/wai-telegram/restic-password
AWS_ACCESS_KEY_ID=your-object-storage-access-key
AWS_SECRET_ACCESS_KEY=your-object-storage-secret-key
