[Unit]
Description=WAI Telegram owner metadata reconciliation without media backfill
After=docker.service wai-backend.service wai-listener.service wai-search-indexes.service
Requires=docker.service

[Service]
Type=oneshot
User=wai
Group=wai
WorkingDirectory=/opt/wai-telegram/packages/backend
EnvironmentFile=/opt/wai-telegram/.env.production
ExecStartPre=+/bin/sh -c 'n=0; until docker exec wai-telegram-db pg_isready -U telegram -d telegram_ai >/dev/null 2>&1; do n=$((n+1)); [ $n -ge 30 ] && exit 1; sleep 2; done'
ExecStart=/opt/wai-telegram/.venv/bin/python -m app.cli.reconcile_metadata --batch-size 500
TimeoutStartSec=infinity
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
PrivateTmp=true
