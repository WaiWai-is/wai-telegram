[Unit]
Description=WAI Telegram quarterly restore drill
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
CacheDirectory=wai-telegram-restic
Environment=RESTIC_CACHE_DIR=/var/cache/wai-telegram-restic
ExecStart=/opt/wai-telegram/scripts/restic-restore-drill.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp /var/cache/wai-telegram-restic
