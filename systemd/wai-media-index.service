[Unit]
Description=WAI Telegram Media Index Worker
After=network.target docker.service wai-backend.service
Requires=docker.service
RequiresMountsFor=/srv/wai-telegram-media

[Service]
Type=simple
User=wai
Group=wai
SupplementaryGroups=wai-media
WorkingDirectory=/opt/wai-telegram/packages/backend
Environment="PATH=/home/wai/.local/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=/opt/wai-telegram/.env.production
ExecStartPre=+/bin/sh -c 'n=0; until docker exec wai-telegram-redis redis-cli ping >/dev/null 2>&1; do n=$((n+1)); [ $n -ge 30 ] && exit 1; sleep 2; done'
ExecStartPre=/usr/bin/mountpoint -q /srv/wai-telegram-media
ExecStart=/opt/wai-telegram/.venv/bin/celery -A app.tasks.celery_app:celery_app worker --hostname=media-index@%H --loglevel=info --queues=media-index --concurrency=2 --prefetch-multiplier=1
Restart=always
RestartSec=10
TimeoutStopSec=3600
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/srv/wai-telegram-media /tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
