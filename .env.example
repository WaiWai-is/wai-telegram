# Database
DATABASE_URL=postgresql+asyncpg://telegram:telegram_dev@localhost:5432/telegram_ai

# Redis
REDIS_URL=redis://localhost:6379

# Telegram API credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Telegram Bot token (get from @BotFather) — used for sending digests
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_API_BASE_URL=http://127.0.0.1:8081

# Encryption key for Telegram sessions (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_key

# OpenAI API key for generation, vision, embeddings, and media summaries
OPENAI_API_KEY=sk-...
GENERATION_MODEL=gpt-5.6-luna
MEDIA_SUMMARY_MODEL=gpt-5.6-luna
MEDIA_IMAGE_MAX_OUTPUT_TOKENS=1600

# JWT secret key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your_jwt_secret
OWNER_USER_ID=

# Durable media cache (override to a writable local directory in development)
MEDIA_ROOT=/tmp/wai-telegram-media

# Sentry DSN for error tracking (get from sentry.io)
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_ENABLE_LOGS=true
SENTRY_DEBUG=false

# Deepgram Nova-3 batch transcription (voice, audio, video)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# Cloudflare for site deployment
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Frontend API (optional in local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000
