# WAI Telegram AI - Production Environment Variables
# Copy this file to .env.production and fill in the values

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql+asyncpg://telegram:YOUR_SECURE_PASSWORD@localhost:5432/telegram_ai
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD

# ===========================================
# REDIS
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# TELEGRAM API
# ===========================================
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# Telegram Bot token (get from @BotFather) — used for sending digests to users
TELEGRAM_BOT_TOKEN=
# Runtime bot traffic must use the official localhost Bot API server.
TELEGRAM_BOT_API_BASE_URL=http://127.0.0.1:8081
MEDIA_PIPELINE_ENABLED=true

# ===========================================
# ENCRYPTION
# ===========================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key

# ===========================================
# JWT / AUTH
# ===========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_jwt_secret_key
# UUID of the only active production user. Startup fails on any mismatch.
OWNER_USER_ID=

# ===========================================
# OPENAI (Embeddings and media summaries)
# ===========================================
OPENAI_API_KEY=
MEDIA_SUMMARY_MODEL=gpt-5.6-luna

# ===========================================
# DEEPGRAM (Background audio/video transcription)
# ===========================================
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# ===========================================
# ANTHROPIC (Digests)
# ===========================================
ANTHROPIC_API_KEY=

# ===========================================
# APPLICATION
# ===========================================
ENVIRONMENT=production
DEBUG=false
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_ENABLE_LOGS=true
SENTRY_DEBUG=false

# Sync configuration
SYNC_BATCH_SIZE=100
SYNC_DELAY_SECONDS=1.0
FLOOD_WAIT_MULTIPLIER=1.2

# Persistent attached volume; this must be a real mountpoint in production.
MEDIA_ROOT=/srv/wai-telegram-media
MEDIA_DOWNLOAD_STALL_TIMEOUT_SECONDS=120
MEDIA_DOWNLOAD_CHUNK_BYTES=524288
MEDIA_PROGRESS_CHECKPOINT_BYTES=8388608
VIDEO_FRAME_INTERVAL_SECONDS=30
PDF_OCR_BATCH_PAGES=8

# Digest model
DIGEST_MODEL=claude-sonnet-4-6

# ===========================================
# FRONTEND
# ===========================================
# Required for stable Next.js Server Action IDs across deploys.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=your_base64_32byte_key
NEXT_PUBLIC_API_URL=https://telegram.waiwai.is
